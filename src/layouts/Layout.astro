---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  titleJa?: string;
  description?: string;
  descriptionJa?: string;
  activeSection?: string;
  ogImage?: string;
  noindex?: boolean;
  hideHeader?: boolean;
  favicon?: string;
}

const {
  title,
  titleJa,
  description = 'Studio Kaku: Art framing, installation, consultancy and creative direction in Tokyo.',
  descriptionJa,
  activeSection,
  ogImage = '/images/og-logo.jpg',
  noindex = false,
  hideHeader = false,
  favicon = '/favicon.png',
} = Astro.props;

const siteURL = 'https://studio-kaku.com';
// GitHub Pages redirects /about to /about/, so the canonical needs the slash
const canonicalPath = Astro.url.pathname.replace(/\/?$/, '/');
const canonicalURL = new URL(canonicalPath, siteURL).href;
const ogImageURL = new URL(ogImage, siteURL).href;
const pageTitle = title === 'Home' ? 'Studio Kaku | Art Consultancy & Custom Framing in Tokyo' : `${title} | Studio Kaku`;
// Used for the /ja copy of the page (see integrations/ja-pages.mjs)
const pageTitleJa = titleJa && (title === 'Home' ? titleJa : `${titleJa} | Studio Kaku`);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${siteURL}/#studio-kaku`,
  name: 'Studio Kaku',
  description: 'Art consultancy, custom framing, curation and installation in Tokyo, for collectors, companies, galleries and hotels across Japan.',
  url: `${siteURL}/`,
  logo: `${siteURL}/studio-kaku-logo.png`,
  image: `${siteURL}/images/og-logo.jpg`,
  email: 'hello@studio-kaku.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tokyo',
    addressCountry: 'JP',
  },
  areaServed: [{ '@type': 'City', name: 'Tokyo' }, { '@type': 'Country', name: 'Japan' }],
  founder: [
    { '@type': 'Person', name: 'Yuki Kakuno' },
    { '@type': 'Person', name: 'Eleanor Ford' },
  ],
  knowsAbout: ['Art consultancy', 'Custom picture framing', 'Art curation', 'Art installation', 'Hotel art curation', 'Artist commissions'],
  knowsLanguage: ['en', 'ja'],
  sameAs: ['https://www.instagram.com/studio.kaku', 'https://www.jukaframing.com'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-en={pageTitleJa && pageTitle} data-ja={pageTitleJa}>{pageTitle}</title>
    <meta name="description" content={description} data-ja-content={descriptionJa} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Studio Kaku" />
    <meta property="og:title" content={pageTitle} data-ja-content={pageTitleJa} />
    <meta property="og:description" content={description} data-ja-content={descriptionJa} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="ja_JP" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} data-ja-content={pageTitleJa} />
    <meta name="twitter:description" content={description} data-ja-content={descriptionJa} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Icons & theme -->
    <link rel="icon" type="image/png" href={favicon} />
    <meta name="theme-color" content="#FAFAF8" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <style>
      @font-face {
        font-family: 'YuMincho';
        src: url('/fonts/YuMincho-Medium.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

[data-fade] {
        opacity: 0;
        transform: translateY(28px) scale(0.97);
        transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-fade].is-visible {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
      [data-fade-text] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
      }
      [data-fade-text].is-visible {
        opacity: 1;
        transform: translateY(0);
      }
      html.lang-ja body,
      html.lang-ja p,
      html.lang-ja a,
      html.lang-ja span,
      html.lang-ja button {
        font-family: 'Noto Sans JP', sans-serif;
      }
      html.lang-ja h1,
      html.lang-ja h2,
      html.lang-ja h3 {
        font-family: 'YuMincho', 'Noto Sans JP', serif;
      }
      .heading-ja {
        display: block;
        font-family: 'YuMincho', serif;
        font-size: 0.35em;
        color: #8A8A8A;
        margin-top: 0.4em;
        letter-spacing: 0.06em;
        font-weight: 400;
        text-transform: none;
      }
      html.lang-ja .heading-ja {
        display: none;
      }
    </style>
  </head>
  <body class="bg-brand-bg text-brand-text font-sans antialiased min-h-screen flex flex-col">
    {!hideHeader && <Header activeSection={activeSection} />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.05, rootMargin: '0px 0px -30px 0px' }
      );
      document.querySelectorAll('[data-fade], [data-fade-text]').forEach((el) => observer.observe(el));
    </script>
    <script>
      (function () {
        const KEY = 'sk-lang';

        function applyLang(lang: string) {
          const isJa = lang === 'ja';
          document.documentElement.classList.toggle('lang-ja', isJa);
          document.documentElement.lang = lang;

          document.querySelectorAll('[data-ja]').forEach(function (el) {
            const text = isJa ? el.getAttribute('data-ja') : el.getAttribute('data-en');
            if (text !== null) (el as HTMLElement).innerHTML = text;
          });

          document.querySelectorAll('.lang-toggle').forEach(function (btn) {
            (btn as HTMLElement).textContent = isJa ? 'EN' : '日本語';
          });

          document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
            const active = (btn as HTMLElement).dataset.langBtn === lang;
            btn.setAttribute('aria-pressed', String(active));
            btn.classList.toggle('bg-brand-text', active);
            btn.classList.toggle('text-brand-bg', active);
            btn.classList.toggle('border-brand-text', active);
          });

          localStorage.setItem(KEY, lang);
        }

        // Pages with a real Japanese/English counterpart (/ja/...) switch by
        // going to that page; others just swap the text in place.
        function setLang(lang: string) {
          const alt = document.querySelector('link[rel="alternate"][hreflang="' + lang + '"]') as HTMLLinkElement | null;
          const altPath = alt && new URL(alt.href).pathname;
          if (altPath && altPath !== window.location.pathname) {
            localStorage.setItem(KEY, lang);
            window.location.href = altPath + window.location.hash;
            return;
          }
          applyLang(lang);
        }

        (window as any).setLang = setLang;
        (window as any).toggleLang = function () {
          setLang(document.documentElement.lang === 'ja' ? 'en' : 'ja');
        };

        applyLang(document.documentElement.dataset.pageLang || localStorage.getItem(KEY) || 'en');
      })();
    </script>


  </body>
</html>

          </label>
          <textarea id="message" name="message" rows="3"
            class="w-full border-b border-brand-border bg-transparent pb-3 text-sm focus:outline-none focus:border-brand-text transition-colors resize-none"
            placeholder="Anything you'd like us to know…"></textarea>
        </div>

        <button type="submit"
          class="w-full bg-brand-text text-brand-bg py-5 text-xs tracking-widest uppercase hover:opacity-80 transition-opacity">
          Send RSVP
        </button>
      </form>

      <div id="success-msg" style="display:none;" class="py-20 text-center">
        <h2 class="name-script mb-6" style="font-size: clamp(2rem, 4vw, 3rem);">Thank you!</h2>
        <p class="text-brand-muted text-sm leading-relaxed">
          We've received your RSVP.<br />
          We'll be in touch with more details soon.
        </p>
      </div>
      <p id="error-msg" style="display:none;" class="mt-4 text-sm text-red-600">
        Something went wrong. Please try again or email us directly.
      </p>
    </div>
  </section>
</Layout>

<script>
  const attendingInputs = document.querySelectorAll<HTMLInputElement>('input[name="attending"]');
  const attendingFields = document.getElementById('attending-fields')!;
  attendingInputs.forEach(input => {
    input.addEventListener('change', () => {
      attendingFields.style.display = input.value === 'yes' ? 'block' : 'none';
    });
  });

  document.getElementById('sunday-yes')!.addEventListener('change', () => {
    document.getElementById('snorkel-fields')!.style.display = 'block';
  });
  document.getElementById('sunday-no')!.addEventListener('change', () => {
    document.getElementById('snorkel-fields')!.style.display = 'none';
  });

  document.getElementById('babysitter-yes')!.addEventListener('change', () => {
    document.getElementById('babysitter-fields')!.style.display = 'block';
  });
  document.getElementById('babysitter-no')!.addEventListener('change', () => {
    document.getElementById('babysitter-fields')!.style.display = 'none';
  });

  const infoBtns = document.querySelectorAll<HTMLButtonElement>('.info-btn');
  infoBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById('panel-' + btn.dataset.panel)!;
      const isOpen = panel.classList.contains('open');
      document.querySelectorAll('.info-panel').forEach(p => p.classList.remove('open'));
      infoBtns.forEach(b => b.classList.remove('active'));
      if (!isOpen) { panel.classList.add('open'); btn.classList.add('active'); }
    });
  });

  const form = document.getElementById('rsvp-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-msg')!;
  const errorMsg = document.getElementById('error-msg')!;
  form.addEventListener('submit', async e => {
    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    submitBtn.textContent = 'Sending…';
    submitBtn.disabled = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (res.ok) { form.style.display = 'none'; successMsg.style.display = 'block'; }
      else { errorMsg.style.display = 'block'; submitBtn.textContent = 'Send RSVP'; submitBtn.disabled = false; }
    } catch { errorMsg.style.display = 'block'; submitBtn.textContent = 'Send RSVP'; submitBtn.disabled = false; }
  });
</script>

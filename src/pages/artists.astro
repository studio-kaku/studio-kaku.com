---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Art Advice',
    desc: 'Site visits to advise on what type of art would fit and stand out in each space. Relationship building to understand your aspirations, taste, and ambitions.',
  },
  {
    title: 'Art Curation',
    desc: 'An array of display concepts and ideas tailored to the space, timeline, and budget — from a single statement piece to a full programme.',
  },
  {
    title: 'Negotiating & Commissioning',
    desc: 'Working directly with artists to create the perfect piece for your project, managing price, timeline and deliverables.',
  },
  {
    title: 'Exhibition Design',
    desc: 'Advanced planning, timelines, concepts and exhibition price lists for larger-scale installations and public programmes.',
  },
  {
    title: 'Shipment & Installation',
    desc: 'Best-market shipment service door to door, with full installation management so the client has nothing to worry about.',
  },
  {
    title: 'Framing',
    desc: 'Custom-made framing to enhance the beauty of each artwork, reviewed across all different sizes, materials, and types.',
  },
];

const sections = [
  {
    id: 'japanese-artists',
    label: 'Section 01',
    title: 'Japanese Artists',
    artists: [
      {
        id: '01',
        bio: `Born in Ehime, Japan in 1984, moved to New York at the age of 18 with only the clothes on his back and a bag full of artwork materials. This self-taught artist began his career by selling his works on the street, sourcing newspapers and scraps of magazines from the trash to create the collage works that are now his signature aesthetic. Over the next five years, he worked his way into the New York art scene, eventually establishing his presence in Hong Kong — where he actively held shows and participated in fairs across East Asia and Europe for nine years — before moving to Tokyo, where he now lives and works.`,
        category: 'Painting / Collage',
        price: '¥300,000-$10,000 (¥1,450,000)',
      },
      {
        id: '02',
        bio: `Born in Tokyo, raised in the States and later moved to the U.K. to study at University of Arts London. At Chelsea College of Arts and Design she majored in Fine Art. Since then she has exhibited in many galleries around Japan and in London whilst also collaborating with major brands domestically and internationally. She is quite playful with her organic shapes and pastel colours, allowing people to relate with her work and enjoy it even more.`,
        category: 'Painting',
        price: '¥300,000-$10,000 (¥1,450,000)',
      },
      {
        id: '03',
        bio: `Born 1989 in Shizuoka, Japan, she graduated from Musashino Art University in 2015 with a degree in oil painting. Her work focuses on paintings constructed from the starting point of forms created by dripping and blotting of paint. Since 2023, she has been based in Nagano and Tokyo. She has had a few recent major solo exhibitions in galleries, museums and shopping centres, and has been selected for art prizes in and around Japan. Her paintings are mainly constructed from shapes that come about from dripping and spreading paint — she likes deconstructing and reconstructing her paintings.`,
        category: 'Painting',
        price: '¥300,000-¥1,000,000',
      },
      {
        id: '04',
        bio: `A painter with roots in Japan, Korea, and Russia. She moved to the United States alone when she was 16 years old. Her style is influenced by retro-school tones, LA street surf culture, and a psychedelic, pop, ennui vibe. In her seemingly fun and approachable paintings, you can sense her emptiness and loneliness, her way of being as a woman, her hidden anger and resignation. By using pastel and rich colours, she does not simply reduce them to negative expressions but sublimates them into her pop and unique works.`,
        category: 'Painting',
        price: '¥100,000-¥600,000',
      },
      {
        id: '05',
        bio: `Born in Tottori, he keeps a daily diary — not in words alone, but in line. The emotions and quiet shifts of each day become a single, unbroken mark: drawn from the discipline of calligraphy, but freed from its conventions. The line isn't a symbol carrying fixed meaning — it's something to be read and felt at the same time, a trace of hesitation, breath and the body's own rhythm. In some works, excerpts from the diary are installed alongside the drawings, making the conversation between text and line visible.`,
        category: 'Drawing / Calligraphy',
        price: '$2,000-$5,000 / ¥290,000-¥725,000',
      },
      {
        id: '06',
        bio: `In 2013, he started 'The Couple' series, inspired by the hands and feet of ukiyo-e shunga, with the theme of relationships. He has a wide range of expressions, including sculpture, painting, and drawing. The artist refers to 'relationship' as a phenomenon that occurs when things are connected and interact with each other, visualising this invisible interaction as 'entanglement.' His work explores the intricate intertwining of limbs and the deeper meanings inherent therein.`,
        category: 'Sculpture / Painting / Drawing',
        price: 'From $2,000 / ¥290,000',
      },
      {
        id: '08',
        bio: `Graduated from Tokyo Polytechnic University. All his painting, sculpture and ceramic work carries the theme of Love. Working on all different projects in many different countries, his theme originated from sending postcards to his grandmother when he was younger.`,
        category: 'Painting / Ceramics / Sculpture',
        price: '$5,000-$20,000 / ¥725,000-¥2,900,000',
      },
      {
        id: '09',
        bio: `An artist modernising traditional Japanese calligraphy shodō, pursuing unconventional light and contemporary expressions. Born in Okinawa, he began shodō at the age of four and inherited the influences of Zen philosophy and Okinawan spiritual culture from his grandfather, a Zen monk and revered folklorist in Japan. He graduated from the department of Space Design at Shizuoka University of Art and Culture, and currently resides and works from his studio in Okinawa.`,
        category: 'Calligraphy (Shodō)',
        price: '$5,000-$15,000 / ¥725,000-¥2,175,000',
      },
      {
        id: '10',
        bio: `Based on her own experiences and sensations, she expresses the way in which the body and the environment contain each other and continue to change fluidly, by blurring the relationship between figure and ground in her paintings. She creates paintings using wood, Japanese paper and mineral pigments.`,
        category: 'Painting',
        price: '$2,000-$10,000 / ¥290,000-¥1,450,000',
      },
    ],
  },
  {
    id: 'japanese-immersive',
    label: 'Section 02',
    title: 'Japanese Immersive',
    artists: [
      {
        id: '11',
        bio: `Born in 1983, an artist who moves between multiple realms — fine art and commercial art, digital and physical, urban youth culture and the natural world. Under the theme of 'visualisation of invisibles', he presented a huge installation combining two-dimensional, three-dimensional, and video works in a space of 1,300 square metres. He has since been active internationally, participating in the Tokyo Pop Underground exhibition at Jeffrey Deitch in New York, with his 'Resolution' series exhibited at Isetan Shinjuku, Tokyo, and in Guangdong, China, and Hong Kong.`,
        category: 'Installation',
        price: 'Price on request',
      },
      {
        id: '12',
        bio: `A Tokyo-born contemporary artist who graduated from Tama Art University's printmaking programme. She later established her own art practice and online atelier, focusing on sculptural works made from fabric, cotton, thread, ceramics, and traditional heated iron techniques rooted in European clothing culture. Her work explores themes of life, growth, and natural cycles, translating botanical forms into symbolic and organic sculptural installations. She has received the Grand Prix in the EXHIBITION section of SICF and has shown at Spiral Garden in Tokyo and internationally, including a solo exhibition in Taipei.`,
        category: 'Sculpture / Installation',
        price: 'Price on request',
      },
    ],
  },
  {
    id: 'japanese-ceramics',
    label: 'Section 03',
    title: 'Japanese Ceramics & Object',
    artists: [
      {
        id: '14',
        bio: `An artist unit creating works with waste materials, resin, and motor appliances, who have expanded into furniture, products, and space direction. They are garnering much attention both domestically and abroad for their vaguely nostalgic works that fuse analogue aesthetics and vivid colour.`,
        category: 'Object / Installation',
        price: '¥50,000-¥500,000',
      },
      {
        id: '15',
        bio: `Bamboo artist. Graduated from Waseda University Faculty of Commerce. While attending university, he was moved by the work of Shounsai Ikuno, a Living National Treasure, and aspired to become a bamboo artist. After graduating, he trained in bamboo crafts at the Oita Prefectural Bamboo Craft Training Centre.`,
        category: 'Bamboo',
        price: 'Price on request',
      },
      {
        id: '16',
        bio: `Forms are seemingly expressive, but retain technical and historical significance. The unique abstractions that the artist constructs from clay build upon the rich history of Shigaraki vessels and take this tradition to its natural conclusion with their experimental forms and explosive dynamic glazes. These works give off the illusion of bubbling outwards or collapsing inwards, emphasising the beauty in that which is flawed.`,
        category: 'Ceramics',
        price: '€5,500-$50,000 / ¥900,000-¥7,250,000',
      },
      {
        id: '17',
        bio: `Born in Osaka in 1969, he grew up in Amagasaki, Hyogo Prefecture. Since childhood, he has been driven by a deep philosophical interest in how the universe functions on micro and macro levels. This awareness of impermanence and the transience of earthly things has guided his work and lifestyle. He currently divides his time between working as an organic rice farmer, a fisherman, and an artist in Japan's Chiba Prefecture.`,
        category: 'Ceramics',
        price: '$10,000-$30,000 / ¥1,450,000-¥4,350,000',
      },
      {
        id: '21',
        bio: `Born in Kyoto in 1988 to a family of painters, he grew up immersed in art from an early age. After completing his BFA in craft at Kanazawa College of Art and Craft, he turned his focus to ceramics and the wider international art world. He believes ceramic holds a unique potential — to function as a kind of universal language, one that moves freely across cultures, borders and people.`,
        category: 'Ceramics',
        price: '$5,500-$35,000 / ¥800,000-¥5,100,000',
      },
      {
        id: '22',
        bio: `His works are not confined to the framework of ceramics, but have a distinctive metallic look and feel. Taking the space itself as an installation, he shows us geometric scenes of rectangles, spheres, and other objects that exceed 2 metres in length. His pieces are entirely shaped by hand, twisting layers of clay and finished with a metallic glaze before firing in an enormous brick kiln.`,
        category: 'Ceramics / Sculpture',
        price: '€10,000 and above / ¥1,630,000 and above',
      },
      {
        id: '23',
        bio: `Around 2014, this artist found an original pattern incorporating light, space, and the appearance of viewing the work into her concept. She continues to draw patterns compatible with various environments and motifs — such as wood, ground, snow, and sand. More recently she has encountered traditional materials and techniques of Washi and Indigo Dyeing, deepening her work by incorporating the harmony of these materials and techniques.`,
        category: 'Textiles / Pattern / Washi',
        price: 'Price on request',
      },
      {
        id: '24',
        bio: `A sculptor from Kawagoe city who studied sculpture at Tokyo University of the Arts before attending the Academy of Fine Arts in Nuremberg, Germany. He refrains from giving his characters distinct facial features or expressions, favouring simple and generalised forms. Slow and careful carving of their loosely rendered faces, the figures display his adherence to representing the essence of nature as opposed to replicating it.`,
        category: 'Sculpture',
        price: 'From $2,000 / ¥290,000 and above',
      },
      {
        id: '25',
        bio: `A sculptor who draws lines and carves wood to reveal the margins between them. Her early works followed the natural grain and annual rings of the wood itself; more recently her focus has shifted to lines drawn from her own daily life — books, letters, hand gestures, typefaces — translating two-dimensional marks into three-dimensional relief. The chisel work reflects close observation of the material, and each carved line carries its own rhythm: the hesitation of the hand, the weight of the tool, the breath between cuts.`,
        category: 'Sculpture / Wood Carving',
        price: '¥100,000-¥500,000',
      },
      {
        id: '26',
        bio: `His ceramics draw from the ancient and the cross-cultural: the simplicity of Jomon pottery, Korean Yi Dynasty vessels and ancient Greek sculpture. He works consciously with combination — layering influences the way everyday life does intuitively, finding new forms at the intersection. Drawn not to the meaning of letters and symbols from cultures he cannot read, but to the shapes of them — the proportions of a closed square, the length of a stroke — he builds an imaginary history around what he sees. His practice is a search for new originals: forms that emerge from the meeting of different races, cultures and histories.`,
        category: 'Ceramics',
        price: '$5,000-$15,000 / ¥725,000-¥2,175,000',
      },
    ],
  },
];
---

<Layout
  title="Artists"
  description="Studio Kaku represents exceptional contemporary Japanese artists — spanning painting, immersive installation, ceramics, and object-making."
>
  <!-- Hero -->
  <section class="px-8 md:px-12 pt-14 md:pt-20 pb-10 md:pb-16">
    <p class="text-brand-muted text-xs tracking-widest uppercase mb-6">Studio Kaku</p>
    <h1 class="font-display uppercase leading-none text-3xl md:text-4xl lg:text-5xl">
      Artist Collection
    </h1>
  </section>

  <!-- Intro -->
  <section class="px-8 md:px-12 py-12 md:py-16 border-t border-brand-border">
    <div class="max-w-2xl" data-fade-text>
      <p class="font-sans leading-snug text-lg md:text-xl">
        We connect collectors and companies with Japan's most exceptional contemporary artists.
      </p>
    </div>
  </section>

  <!-- Artist sections -->
  {
    sections.map((section) => (
      <section id={section.id} class="border-t border-brand-border">
        <!-- Section header -->
        <div class="px-8 md:px-12 py-10 md:py-14" style="background: color-mix(in srgb, #B5A694 12%, #FAFAF8);">
          <p class="text-brand-muted text-xs tracking-widest uppercase mb-3">{section.label}</p>
          <h2 class="font-display uppercase leading-none text-2xl md:text-3xl lg:text-4xl">
            {section.title}
          </h2>
        </div>

        <!-- Artist entries -->
        {section.artists.map((artist, i) => (
          <div class="border-t border-brand-border" data-fade>
            <div class="px-8 md:px-12 py-10 md:py-12 flex flex-col md:flex-row gap-8 md:gap-14 items-start">
              <!-- Bio (left, primary) -->
              <div class="shrink-0" style="width: clamp(260px, 35%, 440px);">
                <p class="text-brand-accent text-xs tracking-widest uppercase mb-4 font-sans">
                  {String(i + 1).padStart(2, '0')}
                </p>
                {artist.bio
                  ? <p class="text-brand-muted text-sm leading-relaxed">{artist.bio}</p>
                  : <p class="text-brand-muted text-sm italic">—</p>
                }
              </div>
              <!-- Artwork (right, fills remaining space) -->
              <div class="flex-1 min-w-0 overflow-hidden">
                <img
                  src={`/artists/images/artist-${artist.id}.jpg`}
                  alt={`Works by artist ${artist.id}`}
                  class="w-full block"
                  width="1440"
                  height="440"
                  loading="lazy"
                />
              </div>
            </div>
            <!-- Category / Price strip -->
            <div class="px-8 md:px-12 py-3 border-t border-brand-border flex gap-8 text-xs bg-brand-bg">
              <span class="text-brand-muted tracking-widest uppercase">Category</span>
              <span class="text-brand-text">{artist.category || ''}</span>
              <span class="text-brand-muted tracking-widest uppercase ml-auto">Price</span>
              <span class="text-brand-text">{artist.price || ''}</span>
            </div>
          </div>
        ))}
      </section>
    ))
  }

  <!-- Services -->
  <section class="px-8 md:px-12 py-12 md:py-16 border-t border-brand-border">
    <p class="text-brand-muted text-xs tracking-widest uppercase mb-4">What We Offer</p>
    <h2 class="font-display uppercase leading-none text-2xl md:text-3xl mb-10 md:mb-12">
      Services
    </h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-brand-border">
      {
        services.map((s) => (
          <div class="bg-brand-bg p-6 md:p-8" data-fade>
            <h3 class="font-sans text-sm tracking-wide mb-2">{s.title}</h3>
            <p class="text-brand-muted text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="px-8 md:px-12 py-16 md:py-24 border-t border-brand-border">
    <div class="max-w-xl" data-fade-text>
      <p class="text-brand-muted text-xs tracking-widest uppercase mb-6">Get in Touch</p>
      <h2 class="font-display uppercase leading-none text-2xl md:text-3xl mb-8">
        Interested in any of these artists?
      </h2>
      <p class="text-brand-muted leading-relaxed mb-8 text-sm">
        To enquire about any of the artists in this roster, discuss a commission, or talk through your
        project, get in touch with Eleanor directly.
      </p>
      <a
        href="/contact"
        class="inline-block border border-brand-text px-8 py-3 text-xs tracking-widest uppercase hover:bg-brand-text hover:text-brand-bg transition-colors duration-200"
      >
        Contact Eleanor
      </a>
    </div>
  </section>
</Layout>
